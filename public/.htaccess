# Enable client-side routing & HTTPS redirect helpers for Apache (Hostinger shared)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS (optional — Hostinger often handles this in hPanel)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Serve existing files/directories as-is
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Fallback for SPA-style paths (Next static export already emits folders)
  RewriteRule ^ index.html [L]
</IfModule>

# Security / caching headers (best-effort on shared hosting)
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
